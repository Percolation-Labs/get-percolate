# Copy to .env next to docker-compose.yml. Every value below has a working
# default, so this file is only needed when something other than you can reach
# the stack -- at which point all five matter.

POSTGRES_USER=p8
POSTGRES_PASSWORD=change-me

# The two roles the services connect as. Neither holds a table grant.
P8_AUTHENTICATOR_PASSWORD=change-me
P8_WORKER_PASSWORD=change-me

# Signs and verifies the JWTs PostgREST and the services read claims from.
# HS256, so it must be at least 32 bytes: openssl rand -base64 48
P8_JWT_SECRET=change-me-a-long-random-string-at-least-32-chars

MINIO_USER=p8admin
MINIO_PASSWORD=change-me

# Resolved by NAME from the worker's environment when a step names it as
# credential_ref. Leave empty if no step calls a model.
LLM_API_KEY=

# Host ports. Every default matches what the documentation connects to, so you
# only set these when something already holds the port -- most often 5432, if
# you already run Postgres. Changing P8_PG_PORT means your DSN's port changes
# too; the in-container 5432 does not, so `docker compose exec db psql` is
# unaffected.
P8_PG_PORT=5432
P8_REST_PORT=3000
P8_CONTENT_PORT=8081
P8_AGENT_PORT=8080
P8_MINIO_PORT=9000
P8_MINIO_CONSOLE_PORT=9001
